# ==============================================================================
# SERVER & DATABASE CONFIGURATION TEMPLATE (.env.example)
# (Toàn bộ cài đặt ví, sàn, bot và rủi ro được cấu hình trong Admin Panel)
# ==============================================================================

# Django Secret Key & Debug Mode
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True

# MySQL Database Configuration
DB_NAME=sandbox_exness
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
